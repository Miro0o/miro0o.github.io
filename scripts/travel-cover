#!/usr/bin/env node

import { existsSync, mkdirSync, readFileSync, renameSync, statSync, writeFileSync } from "node:fs";
import { basename, dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";

const siteRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const dataPath = resolve(siteRoot, "assets/data/travel-data.js");
const overridesPath = resolve(siteRoot, "travel-place-overrides.json");
const outputDirectory = resolve(siteRoot, "assets/images/traveling");

const usage = () => {
  console.log("Usage: scripts/travel-cover IMAGE [--place NAME_OR_ID] [--description TEXT]");
  console.log("If IMAGE still has GPS metadata, --place is optional.");
};

const args = process.argv.slice(2);
if (!args.length || args.includes("--help")) {
  usage();
  process.exit(args.length ? 0 : 2);
}

const input = resolve(process.cwd(), args[0]);
const option = (name) => {
  const index = args.indexOf(name);
  return index >= 0 ? args[index + 1] : "";
};
if (!existsSync(input)) throw new Error(`Image not found: ${input}`);

const source = readFileSync(dataPath, "utf8");
const match = source.match(/window\.TRAVEL_DATA\s*=\s*(\{.*\});\s*$/s);
if (!match) throw new Error(`Could not parse ${dataPath}`);
const data = JSON.parse(match[1]);

const degreesToRadians = (value) => value * Math.PI / 180;
const haversineKm = (aLat, aLon, bLat, bLon) => {
  const latitudeDelta = degreesToRadians(bLat - aLat);
  const longitudeDelta = degreesToRadians(bLon - aLon);
  const latitudeA = degreesToRadians(aLat);
  const latitudeB = degreesToRadians(bLat);
  const h = Math.sin(latitudeDelta / 2) ** 2
    + Math.cos(latitudeA) * Math.cos(latitudeB) * Math.sin(longitudeDelta / 2) ** 2;
  return 6371.0088 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
};

const imageGps = () => {
  const source = resolve(siteRoot, "scripts/read-image-gps.swift");
  const cache = resolve(siteRoot, ".travel-cache");
  const moduleCache = resolve(cache, "swift-module-cache");
  const binary = resolve(cache, "read-image-gps");
  mkdirSync(moduleCache, { recursive: true });
  if (!existsSync(binary) || statSync(binary).mtimeMs < statSync(source).mtimeMs) {
    const fallbackSdk = "/Library/Developer/CommandLineTools/SDKs/MacOSX15.4.sdk";
    const sdk = existsSync(fallbackSdk)
      ? fallbackSdk
      : spawnSync("xcrun", ["--show-sdk-path"], { encoding: "utf8" }).stdout.trim();
    const architecture = spawnSync("uname", ["-m"], { encoding: "utf8" }).stdout.trim();
    const build = spawnSync("xcrun", [
      "swiftc",
      "-sdk", sdk,
      "-module-cache-path", moduleCache,
      "-target", `${architecture}-apple-macosx15.0`,
      "-O",
      "-framework", "Foundation",
      "-framework", "ImageIO",
      source,
      "-o", binary
    ], { stdio: "inherit" });
    if (build.status !== 0) throw new Error("Could not build the local ImageIO GPS reader.");
  }
  const reader = spawnSync(binary, [input], { encoding: "utf8" });
  if (reader.status !== 0) return null;
  const [latitude, longitude] = reader.stdout.trim().split(",").map(Number);
  return Number.isFinite(latitude) && Number.isFinite(longitude) ? { latitude, longitude } : null;
};

const requestedPlace = option("--place").trim().toLocaleLowerCase();
let place = null;
if (requestedPlace) {
  const matches = data.places.filter((candidate) => [candidate.id, candidate.city, candidate.localName]
    .some((value) => String(value || "").toLocaleLowerCase() === requestedPlace));
  if (matches.length !== 1) {
    throw new Error(matches.length
      ? `Place is ambiguous: ${option("--place")}`
      : `Place is not in the current atlas: ${option("--place")}`);
  }
  [place] = matches;
} else {
  const gps = imageGps();
  if (!gps) {
    throw new Error("No GPS metadata found. Add --place with a city name or geonames ID.");
  }
  const candidates = data.places
    .map((candidate) => ({
      candidate,
      distance: haversineKm(gps.latitude, gps.longitude, candidate.latitude, candidate.longitude)
    }))
    .sort((left, right) => left.distance - right.distance);
  if (!candidates.length || candidates[0].distance > 120) {
    throw new Error("GPS is not within 120 km of a current atlas place. Add --place to confirm the card.");
  }
  place = candidates[0].candidate;
  console.log(`GPS matched ${place.localName || place.city} · ${place.city} (${candidates[0].distance.toFixed(1)} km).`);
}

const filename = `manual-${place.id}.jpg`;
const output = resolve(outputDirectory, filename);
const filter = "scale=w='min(1920,iw)':h='min(1920,ih)':force_original_aspect_ratio=decrease:force_divisible_by=2";
const ffmpeg = spawnSync("ffmpeg", [
  "-hide_banner", "-loglevel", "error", "-y",
  "-i", input,
  "-map_metadata", "-1",
  "-map_chapters", "-1",
  "-vf", filter,
  "-frames:v", "1",
  "-q:v", "3",
  output
], { stdio: "inherit" });
if (ffmpeg.status !== 0) throw new Error(`ffmpeg could not process ${basename(input)}`);

const overrides = JSON.parse(readFileSync(overridesPath, "utf8"));
overrides[place.id] ||= { localName: place.localName || place.city, description: "", imageFilename: "" };
overrides[place.id].imageFilename = filename;
if (args.includes("--description")) overrides[place.id].description = option("--description");
const temporaryPath = `${overridesPath}.tmp`;
writeFileSync(temporaryPath, `${JSON.stringify(overrides, null, 2)}\n`);
renameSync(temporaryPath, overridesPath);

const rebuild = spawnSync(process.execPath, [resolve(siteRoot, "scripts/build-travel-data.mjs"), "finalize"], {
  cwd: siteRoot,
  stdio: "inherit"
});
if (rebuild.status !== 0) throw new Error("The public travel data rebuild failed.");

console.log(`Prepared metadata-free cover: ${output}`);
console.log(`The original remains untouched at: ${input}`);
