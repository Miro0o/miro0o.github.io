#!/bin/zsh
set -euo pipefail

SCRIPT_DIR=${0:A:h}
SITE_ROOT=${SCRIPT_DIR:h}
PUBLISHED_DIRECTORY="$SITE_ROOT/assets/images/traveling/published"

if [[ -z "${TRAVEL_R2_ENDPOINT:-}" || -z "${TRAVEL_R2_BUCKET:-}" ]]; then
  print -u2 "Set TRAVEL_R2_ENDPOINT and TRAVEL_R2_BUCKET before uploading."
  print -u2 "Example endpoint: https://ACCOUNT_ID.r2.cloudflarestorage.com"
  exit 2
fi

if [[ ! -d "$PUBLISHED_DIRECTORY" ]]; then
  print -u2 "No published gallery found. Run scripts/travel-photos publish first."
  exit 2
fi

TRAVEL_R2_PREFIX=${TRAVEL_R2_PREFIX:-travel}
aws s3 sync \
  "$PUBLISHED_DIRECTORY/" \
  "s3://$TRAVEL_R2_BUCKET/$TRAVEL_R2_PREFIX/" \
  --endpoint-url "$TRAVEL_R2_ENDPOINT" \
  --exclude '*' \
  --include '*.webp' \
  --content-type 'image/webp' \
  --cache-control 'public,max-age=31536000,immutable' \
  --no-progress

print "Uploaded the generated travel gallery without deleting older remote objects."
print "Set imageBaseUrl in travel-config.json to the public bucket URL, then rerun scripts/travel-photos publish."
